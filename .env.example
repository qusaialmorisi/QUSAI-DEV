# GEMINI_API_KEY: Required on the server for Live AI Lab responses (never expose in VITE_* client env vars).
# Local dev: set in .env (ignored by git).
# Vercel: configure in Project Settings > Environment Variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional public URL where this platform is hosted.
APP_URL="MY_APP_URL"

# PORT: Optional HTTP port for the local Express server (defaults to 3000).
# PORT="3000"
